# Kopier til .env.server og fyll inn (se server/README.md). Filen .env.server skal ALDRI legges i GitHub.

# Adressene (bytt ut dittdomene.no)
URL=https://app.dittdomene.no
VITE_SUPABASE_URL=https://api.dittdomene.no
SUPABASE_URL=https://api.dittdomene.no

# Nøklene fra supabase-project/.env (ANON_KEY og SERVICE_ROLE_KEY)
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-post fra appen (kan også settes opp i appen under Innstillinger)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EPOST_FRA=
EPOST_SVAR=

# Valgfritt – kopier verdiene fra Netlify hvis de er satt der (Site configuration → Environment variables)
RESEND_API_KEY=
UTVIKLER_EPOST=
SELVREGISTRERING=
REGELVERK_ORG=
REGELVERK_TOKEN=
